# The API's base URL as the browser sees it. The default, /api, is same-origin: Vite (dev) and nginx (container)
# proxy it to the API, which has no CORS middleware. Set a full URL only if that origin allows this one.
VITE_API_BASE_URL=/api
# Where the dev and preview servers proxy /api to.
API_PROXY_TARGET=http://localhost:8000
