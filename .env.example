# Copy to .env and fill in; never commit it. docker compose (compose.yaml) and the core both read it.
# Core settings are in config.yaml. Every setting below has a safe default.

# Live inference calls paid providers. It also needs "execution_mode": "live" in each request.
EXPENSE_API_ALLOW_LIVE=false
# A live evaluation with no limit at all (confirm_uncapped). Off unless set; needs EXPENSE_API_ALLOW_LIVE too.
EXPENSE_API_ALLOW_UNCAPPED_EVALUATIONS=false
# JSON list of model IDs a request may choose. In live mode, a request may choose only a listed model. It is the
# policy compiler's extraction allowlist, and the classification or translation allowlist wherever that is unset.
EXPENSE_API_ALLOWED_MODELS=[]
# Each role's own allowlist, so a translator is never offered or accepted as a classifier, nor the reverse. Leave
# unset to use EXPENSE_API_ALLOWED_MODELS for that role. A LangGraph node's model and its reviewer are classification.
# EXPENSE_API_ALLOWED_CLASSIFICATION_MODELS=["anthropic/claude-haiku-5.5","typesafe/jev-1.14"]
# EXPENSE_API_ALLOWED_TRANSLATION_MODELS=["tencent/hy-mt2-30b-a3b"]
# Models a live policy extraction may use. Unset: the allowed models the compiler can send chat completions to,
# never a decision model (Jev) or a model allowed only for translation.
# EXPENSE_API_ALLOWED_EXTRACTION_MODELS=["anthropic/claude-haiku-5.5"]
# The most LangGraph reflection may do for one line, whatever a request or config.yaml asks: revisions after the first
# classification (0 to 10; 0 allows none), and model calls of every kind (1 to 50). A request beyond them is refused.
EXPENSE_API_MAX_REFLECTION_RETRIES=3
EXPENSE_API_MAX_REFLECTION_CALLS_PER_LINE=12
# Read only in live mode, and never stored in a ruleset or run.
OPENROUTER_API_KEY=

# Validation uses only versions published for production. A request may ask for a preview of any other
# version only when this is true: keep it false wherever results matter.
EXPENSE_API_ALLOW_PREVIEW_VALIDATION=false
# JSON list: what an approval may authorize. Simulation readings never authorize production.
EXPENSE_API_ALLOWED_PUBLICATION_MODES=["production"]

# The largest policy document accepted, in UTF-8 bytes.
EXPENSE_API_MAX_DOCUMENT_BYTES=524288

# Policy document contents are stored in this S3 bucket, one private, server-side encrypted object per revision, at
# policy-documents/{document_id}/revisions/{revision}/document.md. MongoDB keeps only metadata and the reference.
# Leave the bucket unset and uploads are refused (503); documents written before S3 storage are still read.
# AWS_S3_BUCKET=expense-validator
AWS_REGION=us-east-1
# Credentials, read by boto3's standard chain; a profile or an instance role works as well. Never commit them.
# The IAM policy needs only s3:PutObject, s3:GetObject (and s3:GetObjectVersion on a versioned bucket) and
# s3:DeleteObject on arn:aws:s3:::BUCKET/policy-documents/*, plus s3:ListBucket on the bucket for --orphans.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Optional SSE-KMS key instead of SSE-S3, and S3-compatible endpoint.
# EXPENSE_API_S3_KMS_KEY_ID=alias/expense-validator
# EXPENSE_API_S3_ENDPOINT_URL=http://host.docker.internal:4566
# EXPENSE_API_S3_DOCUMENT_PREFIX=policy-documents
# EXPENSE_API_S3_RULESET_PREFIX=ruleset-documents
# The IAM grants cover arn:aws:s3:::BUCKET/ruleset-documents/* as well.

# The replay set used when a request names none: openrouter, jev or langgraph.
EXPENSE_API_DEFAULT_REPLAY_SET=openrouter
EXPENSE_API_MONGO_DATABASE=expense_api

# For a run outside Docker, from backend/ (compose sets these itself; paths are relative to backend/):
# EXPENSE_API_CORE_CONFIG=../config.yaml
# EXPENSE_API_MONGO_URI=mongodb://localhost:27017
# EXPENSE_API_COMPILER_RECORDING_SETS={"live": "../evaluation/compiler/live", "recorded": "/some/empty/folder"}
# EXPENSE_API_COMPILER_LIVE_RECORDING_SET=recorded   # where live extractions record their readings; holds model readings only
# EXPENSE_API_REPLAY_SETS={"openrouter": "../evaluation/final/replay", "jev": "../evaluation/jev/runs/first-run/replay", "langgraph": "../evaluation/langgraph/runs/live-claude-jev-1/replay"}

# Evaluations. The worker (python -m expense_api.worker, the compose service "worker") reads the same settings.
# Every model a live run may call counts, including config.yaml's translation.model (tencent/hy-mt2-30b-a3b) whenever
# translation is enabled: it is called for non-English lines. GET /v1/backends reports it under translation.
# A live evaluation also needs EXPENSE_API_ALLOW_LIVE, every model it may call allowed for its role, a budget
# and confirm_live in the request. EXPENSE_API_PRICING_TABLE: optional per-token prices, for estimates only.
# Use a path available inside the container when running with Docker.
# EXPENSE_API_PRICING_TABLE=/srv/pricing.yaml
EXPENSE_API_MAX_DATASET_BYTES=4194304
EXPENSE_API_MAX_DATASET_RECEIPTS=500
EXPENSE_API_WORKER_LEASE_SECONDS=120
