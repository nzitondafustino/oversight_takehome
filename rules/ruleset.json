  "rules": [
    {
      "rule_id": "ALC-01",
      "policy_doc": "meals-and-entertainment-policy.md",
      "title": "Alcohol requires a documented entertainment context",
      "source_quote": "records an attendee count of two or more",
      "status": "active",
      "params": {
        "on_premises": {
          "type": "set",
          "values": [
            "5812",
            "5813",
            "7011"
          ]
        },
        "min_attendees": {
          "type": "number",
          "value": "2",
          "unit": "count",
          "source": "policy"
        }
      },
      "provenance": {
        "translator": "developer",
        "clause_hash": "2e933d0fea6c74f0f6034d55c0a20de4263e0f22e8de8e9777ab8de538acebfd",
        "fingerprint": "2ad36debbfb4a15eb6e32f44f2f9effb6cfe45130da183b4e849399e05b68adb"
      },
      "kind": "check",
      "outcome": "exception",
      "scope": "item",
      "severity": "high",
      "severity_cases": [],
      "applies_when": {
        "op": "all",
        "conditions": [
          {
            "op": "in",
            "field": "receipt.mcc",
            "values": {
              "param": "on_premises"
            }
          },
          {
            "op": "not",
            "condition": {
              "op": "all",
              "conditions": [
                {
                  "op": "eq",
                  "field": "receipt.submitted_expense_type",
                  "value": "Client Entertainment"
                },
                {
                  "op": "gte",
                  "field": "receipt.attendee_count",
                  "value": {
                    "param": "min_attendees"
                  }
                }
              ]
            }
          }
        ]
      },
      "select": {
        "op": "all",
        "conditions": [
          {
            "op": "eq",
            "field": "item.category",
            "value": "alcohol"
          },
          {
            "op": "eq",
            "field": "item.is_purchase",
            "value": true
          }
        ]
      },
      "replaces": []
    },
    {
